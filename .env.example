# Copier en .env (jamais commité).
# Base de données (dev local : PGlite via `npm run dev:db`, port 5544).
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5544/postgres
# Auth (>= 32 caractères, généré par `openssl rand -base64 32`).
BETTER_AUTH_SECRET=change-me-at-least-32-characters-long
BETTER_AUTH_URL=http://localhost:3000
# Postgres (service docker `db`).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=portfolio
# Prod (VPS Debian 12 + Caddy).
SITE_DOMAIN=example.fr
NODE_ENV=production
# Stockage des médias (défaut ./ .media, /data/media en Docker).
MEDIA_DIR=
# Taille du pool Postgres.
DB_POOL_MAX=10
